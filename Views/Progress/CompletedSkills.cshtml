@using SkillFlow.ViewModels.Progress
@model List<UserSkillProgressViewModel>

@{
    ViewData["Title"] = "Completed Skills";
}

<div class="container-fluid py-5">
    <div class="row mb-5">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h1 class="display-4 mb-3">Your Achievements</h1>
                    <p class="text-muted">@Model.Count completed @(Model.Count == 1 ? "skill" : "skills")</p>
                </div>
                <a asp-action="Dashboard" class="btn btn-primary btn-lg">Back to Dashboard</a>
            </div>
        </div>
    </div>

    @if (Model.Any())
    {
        <div class="row">
            @foreach (var skill in Model.OrderByDescending(s => s.CompletedAt))
            {
                <div class="col-md-6 col-lg-4 mb-4">
                    <div class="card h-100 border-0 shadow-sm border-top border-success border-3">
                        <div class="card-body">
                            <div class="d-flex align-items-start justify-content-between mb-3">
                                <div>
                                    <h5 class="card-title mb-2">@skill.SkillTitle</h5>
                                    <div>
                                        <small class="text-muted d-block">@skill.DirectionName</small>
                                        <span class="badge bg-secondary me-2">@skill.Level</span>
                                    </div>
                                </div>
                                <span class="fs-3">✓</span>
                            </div>

                            <div class="progress mb-3" style="height: 8px;">
                                <div class="progress-bar bg-success" role="progressbar" 
                                     style="width: 100%;" 
                                     aria-valuenow="100" 
                                     aria-valuemin="0" 
                                     aria-valuemax="100">
                                </div>
                            </div>

                            @if (skill.CompletedAt.HasValue)
                            {
                                <small class="text-muted">
                                    <i class="far fa-calendar me-2"></i>
                                    Completed: @skill.CompletedAt.Value.ToString("MMMM dd, yyyy")
                                </small>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="row">
            <div class="col-12">
                <div class="alert alert-info" role="alert">
                    <h4 class="alert-heading">No Completed Skills Yet</h4>
                    <p>You haven't completed any skills yet. Start working on your skills and come back here to celebrate your achievements!</p>
                    <hr />
                    <a asp-action="Dashboard" class="btn btn-info">Go to Dashboard</a>
                </div>
            </div>
        </div>
    }
</div>


<style>
    .card {
        transition: transform 0.2s, box-shadow 0.2s;
    }
    .card:hover {
        transform: translateY(-5px);
        box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.15);
    }
</style>

