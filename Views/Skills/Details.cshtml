@using SkillFlow.Models.Enums
@model SkillDetailsViewModel
@{
    ViewData["Title"] = Model?.Title ?? "Skill Details";
}

<div class="row justify-content-center">
    <div class="col-lg-7 col-md-9">
        <a href="@Url.Action("Index", "Skills")" class="btn btn-outline-secondary mb-4">
            <i class="fas fa-arrow-left me-1"></i> Back to Skills
        </a>

        @if (Model != null)
        {
            <div class="card">
                <div class="card-header bg-primary bg-gradient text-white">
                    <h4 class="mb-0">@Model.Title</h4>
                </div>
                <div class="card-body p-4">
                    <dl class="row mb-0">
                        <dt class="col-sm-4 text-muted">Direction</dt>
                        <dd class="col-sm-8">@Model.DirectionName</dd>

                        <dt class="col-sm-4 text-muted">Level</dt>
                        <dd class="col-sm-8">
                            <span class="badge text-bg-@GetLevelClass(Model.Level)">@Model.Level</span>
                        </dd>

                        <dt class="col-sm-4 text-muted">Skill ID</dt>
                        <dd class="col-sm-8 font-monospace text-muted">@Model.Id</dd>
                    </dl>
                </div>
                <div class="card-footer d-flex gap-2">
                    <a href="@Url.Action("Edit", "Skills", new { id = Model.Id })" class="btn btn-warning">
                        <i class="fas fa-edit me-1"></i> Edit
                    </a>
                    <a href="@Url.Action("Delete", "Skills", new { id = Model.Id })" class="btn btn-outline-danger">
                        <i class="fas fa-trash me-1"></i> Delete
                    </a>
                </div>
            </div>
        }
        else
        {
            <div class="alert alert-danger" role="alert">
                <i class="fas fa-exclamation-circle me-1"></i> Skill not found.
            </div>
        }
    </div>
</div>

@functions {
    private string GetLevelClass(SkillLevel level) => level switch
    {
        SkillLevel.Beginner => "success",
        SkillLevel.Intermediate => "warning",
        SkillLevel.Advanced => "danger",
        _ => "secondary"
    };
}