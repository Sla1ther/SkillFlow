@using SkillFlow.Models.Enums
@model SkillDetailsViewModel
@{
    ViewData["Title"] = "Delete Skill";
}

<div class="row justify-content-center">
    <div class="col-lg-7 col-md-9">
        <a href="@Url.Action("Details", "Skills", new { id = Model.Id })" class="btn btn-outline-secondary mb-4">
            <i class="fas fa-arrow-left me-1"></i> Back to Skill
        </a>

        <div class="card border-danger">
            <div class="card-header bg-danger bg-gradient text-white">
                <h4 class="mb-0"><i class="fas fa-trash-alt me-2"></i>Delete Skill</h4>
            </div>
            <div class="card-body p-4">
                @if (ViewBag.HasUserSkills)
                {
                    <div class="alert alert-danger" role="alert">
                        <i class="fas fa-ban me-1"></i>
                        <strong>Cannot Delete.</strong> This skill is assigned to one or more users.
                        Remove all user skill assignments before deleting.
                    </div>
                    <a href="@Url.Action("Details", "Skills", new { id = Model.Id })" class="btn btn-secondary">
                        <i class="fas fa-arrow-left me-1"></i> Go Back
                    </a>
                }
                else
                {
                    <div class="alert alert-warning" role="alert">
                        <i class="fas fa-exclamation-triangle me-1"></i>
                        <strong>Warning!</strong> This action is permanent and cannot be undone.
                    </div>

                    <dl class="row bg-light rounded p-3 mb-4">
                        <dt class="col-sm-4 text-muted">Skill Title</dt>
                        <dd class="col-sm-8">@Model?.Title</dd>

                        <dt class="col-sm-4 text-muted">Direction</dt>
                        <dd class="col-sm-8">@Model?.DirectionName</dd>

                        <dt class="col-sm-4 text-muted mb-0">Level</dt>
                        <dd class="col-sm-8 mb-0">
                            @if (Model != null)
                            {
                                <span class="badge text-bg-@GetLevelClass(Model.Level)">@Model.Level</span>
                            }
                        </dd>
                    </dl>

                    <form method="post" action="@Url.Action("Delete", "Skills", new { id = Model.Id })">
                        @Html.AntiForgeryToken()
                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-danger">
                                <i class="fas fa-trash-alt me-1"></i> Yes, Delete This Skill
                            </button>
                            <a href="@Url.Action("Details", "Skills", new { id = Model.Id })" class="btn btn-outline-secondary">
                                <i class="fas fa-times me-1"></i> Cancel
                            </a>
                        </div>
                    </form>
                }
            </div>
        </div>
    </div>
</div>

@functions {
    private string GetLevelClass(SkillLevel level) => level switch
    {
        SkillLevel.Beginner => "success",
        SkillLevel.Intermediate => "warning",
        SkillLevel.Advanced => "danger",
        _ => "secondary"
    };
}