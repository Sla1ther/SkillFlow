@using SkillFlow.Models.Enums
@model IEnumerable<SkillCardViewModel>
@{
    ViewData["Title"] = "Skills";
}

<div class="container-fluid px-0">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-1"><i class="fas fa-brain me-2"></i>Skills Management</h1>
            <p class="text-muted mb-0">Manage and organize your skills by level and category</p>
        </div>
        <a href="@Url.Action("Create", "Skills")" class="btn btn-primary">
            <i class="fas fa-plus me-1"></i> Add New Skill
        </a>
    </div>

    <div class="card mb-4">
        <div class="card-header">
            <h5 class="mb-0"><i class="fas fa-filter me-2"></i>Filter Skills</h5>
        </div>
        <div class="card-body">
            <form method="get" action="@Url.Action("Index", "Skills")" id="filterForm">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label for="Level" class="form-label">Skill Level</label>
                        <select name="Level" id="Level" class="form-select">
                            <option value="">-- All Levels --</option>
                            @foreach (SkillLevel level in Enum.GetValues(typeof(SkillLevel)))
                            {
                                <option value="@((int)level)"
                                        selected="@(ViewBag.SelectedLevel == level ? "selected" : null)">
                                    @level
                                </option>
                            }
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label for="DirectionId" class="form-label">Direction</label>
                        <select name="DirectionId" id="DirectionId" class="form-select">
                            <option value="">-- All Directions --</option>
                            @if (ViewBag.Directions != null)
                            {
                                @foreach (var direction in ViewBag.Directions)
                                {
                                    <option value="@direction.Id"
                                            selected="@(ViewBag.SelectedDirectionId == direction.Id ? "selected" : null)">
                                        @direction.Name
                                    </option>
                                }
                            }
                        </select>
                    </div>
                    <div class="col-12 d-flex gap-2">
                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-search me-1"></i> Apply Filters
                        </button>
                        <a href="@Url.Action("Index", "Skills")" class="btn btn-outline-secondary">
                            <i class="fas fa-redo me-1"></i> Clear Filters
                        </a>
                    </div>
                </div>
            </form>
        </div>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="row g-4">
            @foreach (var skill in Model)
            {
                <div class="col-lg-4 col-md-6">
                    @await Html.PartialAsync("~/Views/Shared/Components/SkillCard/Default.cshtml", skill)
                </div>
            }
        </div>
    }
    else
    {
        <div class="text-center py-5 text-muted">
            <i class="fas fa-inbox fa-3x mb-3 d-block"></i>
            <p class="mb-3">No skills found matching your criteria.</p>
            <a href="@Url.Action("Create", "Skills")" class="btn btn-primary">
                <i class="fas fa-plus me-1"></i> Create Your First Skill
            </a>
        </div>
    }
</div>